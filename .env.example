# Qué cerebro contesta (también se cambia en vivo desde el tablero):
#   auto        → la API si hay ANTHROPIC_API_KEY, si no respuestas de prueba
#   api         → API de Anthropic con tu key (Claude Sonnet 5.5)
#   suscripcion → tu Claude Code instalado (`claude -p`), con tu suscripción. Solo para uso personal.
#   local       → un modelo en tu compu con LM Studio u Ollama (Qwen, Gemma…). Nada sale de la compu.
ROMEO_PROVEEDOR=auto

# API key de la Consola de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Suscripción: corré `claude setup-token` y pegá acá el token (si no, usa el login de tu Claude Code)
CLAUDE_CODE_OAUTH_TOKEN=
# Opcional: modelo para la suscripción (por defecto claude-sonnet-5-5; si tu Claude Code no lo reconoce, usa "sonnet")
SUSCRIPCION_MODELO=

# Modelo local. LM Studio: http://127.0.0.1:1234/v1 (Developer › Start Server) · Ollama: http://127.0.0.1:11434/v1
LOCAL_BASE_URL=http://127.0.0.1:1234/v1
# Vacío = el primer modelo cargado. Ej.: qwen3:8b, gemma3:12b (Ollama) o el id que muestra LM Studio
LOCAL_MODEL=

# Carpeta del Vault de Obsidian (vacío = la de romeo.config.json)
VAULT_PATH=

# Google Calendar › Configuración del calendario personal › "Dirección secreta en formato iCal"
CALENDAR_ICS_URL=

# Opcional: tu número para vincular con código en vez de QR (solo dígitos, ej. 5491112345678)
WA_PAIRING_PHONE=

# Puerto del tablero
PORT=4545
